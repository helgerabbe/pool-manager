{
  "name": "AktivitaetenKatalog",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name der Aktivit\u00e4t (z.B. 'Video anschauen')"
    },
    "beschreibung": {
      "type": "string",
      "description": "Ausf\u00fchrliche p\u00e4dagogische Beschreibung dieser Aktivit\u00e4t: Was passiert sch\u00fclerseitig, was pflegt die Lehrkraft, wof\u00fcr ist die Aktivit\u00e4t besonders geeignet. Wird im Info-Popup der Aktivit\u00e4ten-Palette unter 'Was ist das?' angezeigt."
    },
    "beispiel": {
      "type": "string",
      "description": "Konkretes Aufgabenbeispiel (2026-08-13): Zeigt im Info-Popup der Aktivit\u00e4ten-Palette unter 'Aufgabenbeispiel', wie eine typische Aufgabenstellung dieser Aktivit\u00e4t lauten k\u00f6nnte. Ersetzt die fr\u00fcher dort angek\u00fcndigte Sch\u00fcler-Vorschau. Darf mehrere kurze Beispiele enthalten (Zeilenumbr\u00fcche werden gerendert)."
    },
    "phase": {
      "type": "string",
      "enum": [
        "Input",
        "\u00dcbung",
        "Abschluss"
      ],
      "description": "Phase des Lernpakets"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Ob die Aktivit\u00e4t global verf\u00fcgbar ist"
    },
    "supports_master": {
      "type": "boolean",
      "default": false,
      "description": "Ob diese Aktivit\u00e4t als Mastervorlage f\u00fcr KI-Klone geeignet ist (z.B. Begriffe zuordnen = true, Lehrwerk/Quelle = false)"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL eines kleinen, sch\u00fclergerechten Symbol-/Thumbnail-Bildes f\u00fcr diese Aktivit\u00e4t. Wird in der Sch\u00fcler-Lernpaket-\u00dcbersicht neben dem Aktivit\u00e4tstitel angezeigt, damit Sch\u00fcler die Aufgabenart auf einen Blick wiedererkennen. In der Admin-Verwaltung austauschbar."
    },
    "form_schema": {
      "type": "array",
      "description": "Array von Feldkonfigurationen f\u00fcr das Frontend-Rendering",
      "items": {
        "type": "object",
        "properties": {
          "field_name": {
            "type": "string",
            "description": "Eindeutiger Feldname (z.B. 'url', 'file', 'text')"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "url",
              "file",
              "image",
              "audio",
              "number",
              "select",
              "json",
              "info"
            ],
            "description": "Feldtyp"
          },
          "label": {
            "type": "string",
            "description": "Anzeige-Label im Formular"
          },
          "required": {
            "type": "boolean",
            "default": false,
            "description": "Ob das Feld erforderlich ist"
          },
          "options": {
            "type": "array",
            "description": "Optionen f\u00fcr Select-Felder",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "placeholder": {
            "type": "string",
            "description": "Placeholder-Text"
          }
        },
        "required": [
          "field_name",
          "type",
          "label"
        ]
      }
    }
  },
  "required": [
    "name",
    "phase"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}