{
  "name": "AllgemeineAufgabe",
  "type": "object",
  "properties": {
    "einheit_id": {
      "type": "string",
      "description": "FK zur Einheit"
    },
    "themenfeld_id": {
      "type": "string",
      "description": "FK zum Themenfeld (optional)"
    },
    "anforderungsebene": {
      "type": "string",
      "enum": [
        "1 - Basis",
        "2 - Transfer",
        "3 - Projekt"
      ],
      "default": "1 - Basis"
    },
    "aufgaben_typ": {
      "type": "string",
      "enum": [
        "inhalt",
        "buendel",
        "prozess",
        "projekt_anker",
        "handlung",
        "auswahl_buendel",
        "externe_html_seite"
      ],
      "default": "inhalt"
    },
    "aufgaben_modus": {
      "type": "string",
      "enum": [
        "einzeln",
        "sequenz"
      ],
      "default": "einzeln"
    },
    "sequenz_schritte": {
      "type": "array",
      "description": "Schritte einer Aufgabensequenz (Material/Aufgabe in fester Reihenfolge). Der eigentliche Schritt-Inhalt liegt je nach Typ in `material` bzw. `aufgabe`.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "typ": {
            "type": "string",
            "enum": [
              "material",
              "aufgabe"
            ]
          },
          "reihenfolge": {
            "type": "number"
          },
          "titel": {
            "type": "string"
          },
          "material": {
            "type": "object",
            "description": "Inhalt eines Material-Schritts.",
            "properties": {
              "material_typ": {
                "type": "string",
                "enum": [
                  "text",
                  "video",
                  "audio",
                  "bild",
                  "pdf",
                  "link"
                ]
              },
              "inhalt": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "datei_url": {
                "type": "string"
              },
              "beschreibung": {
                "type": "string"
              },
              "transkript": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "aufgabe": {
            "type": "object",
            "description": "Inhalt eines Aufgaben-Schritts.",
            "properties": {
              "aufgabenstellung": {
                "type": "string"
              },
              "input_erforderlich": {
                "type": "boolean",
                "default": true
              },
              "musterloesung": {
                "type": "string"
              },
              "feedback_modus": {
                "type": "string",
                "enum": [
                  "musterloesung",
                  "ki"
                ],
                "default": "musterloesung"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "default": []
    },
    "mission_type": {
      "type": "string",
      "enum": [
        "problem",
        "entdeckung",
        "recherche",
        "anwendung",
        "transfer",
        "kreativitaet"
      ]
    },
    "verlinkte_lernpaket_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "verlinkte_projekt_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "verlinkte_aufgaben_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "lernpaket_logik": {
      "type": "string",
      "enum": [
        "standard",
        "fast_track",
        "wissensspeicher",
        "test_only"
      ],
      "default": "standard"
    },
    "erforderliche_anzahl": {
      "type": "integer",
      "default": 0,
      "minimum": 0
    },
    "interne_reihenfolge": {
      "type": "string",
      "enum": [
        "frei",
        "sequenziell"
      ],
      "default": "frei"
    },
    "hinweise_zum_material": {
      "type": "string"
    },
    "aufgabentyp_projekt": {
      "type": "string",
      "enum": [
        "Anwendungsaufgabe",
        "Projektaufgabe"
      ]
    },
    "titel": {
      "type": "string"
    },
    "aufgabenstellung": {
      "type": "string"
    },
    "aufgaben_bild_url": {
      "type": "string"
    },
    "aufgabenstellung_datei_url": {
      "type": "string",
      "description": "Optionale, hochgeladene Datei der Aufgabenstellung (PDF, Doc oder Bild). Nur bei Handlungsaufgaben relevant."
    },
    "aufgabenstellung_datei_name": {
      "type": "string",
      "description": "Urspruenglicher Dateiname der hochgeladenen Aufgabenstellungs-Datei."
    },
    "schwierigkeitsgrad": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "ergebnis_form": {
      "type": "string"
    },
    "ergebnis_dateiformat": {
      "type": "string"
    },
    "erwartungshorizont": {
      "type": "string"
    },
    "erwartungshorizont_datei_url": {
      "type": "string",
      "description": "Optionale hochgeladene Musterloesung/Erwartungshorizont-Datei (PDF, Word, Bild, Screenshot). PDFs und Bilder werden bei der KI-Generierung des Erwartungshorizonts mitgelesen (2026-08-22)."
    },
    "erwartungshorizont_datei_name": {
      "type": "string",
      "description": "Urspruenglicher Dateiname der hochgeladenen Erwartungshorizont-Datei."
    },
    "projekt_ablauf_beschreibung": {
      "type": "string",
      "description": "Projektaufgaben (Ebene 3, 2026-08-12): NICHT schuelersichtbare Beschreibung des geplanten Projekt-Ablaufs fuer die KI. Die Lehrkraft erklaert hier, wie sie sich den Ablauf der Projektarbeit vorstellt (Zwischenschritte, Reihenfolge, was die Schueler in welchem Schritt tun sollen), damit Brian die Schueler Schritt fuer Schritt durch das Projekt fuehren kann. Gepflegt im Tab 'Abgabe & Guetekriterien'; fliesst in generateBrianSegments in die System-Anweisung ein."
    },
    "musterloesung": {
      "type": "string"
    },
    "html_code": {
      "type": "string"
    },
    "lernzielanalyse": {
      "type": "object",
      "additionalProperties": true
    },
    "erstellungs_modus": {
      "type": "string",
      "enum": [
        "manuell",
        "ki"
      ],
      "default": "manuell"
    },
    "ki_briefing": {
      "type": "object",
      "additionalProperties": true
    },
    "alt_text": {
      "type": "string"
    },
    "materialien": {
      "type": "array",
      "description": "Zusaetzliche Materialien zur Aufgabe (Freitext, Buchverweis, PDF, Bild). Fix 2026-08-22: Bis dahin war nur 'type' im Schema definiert, weshalb hochgeladene Dateien (url) und Bezeichnungen (label) beim Speichern still verworfen wurden.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "free_text | book_ref | pdf | image"
          },
          "label": {
            "type": "string",
            "description": "Optionale Bezeichnung des Materials."
          },
          "content": {
            "type": "string",
            "description": "Textinhalt bei free_text / book_ref."
          },
          "url": {
            "type": "string",
            "description": "Datei-URL bei pdf / image."
          }
        },
        "additionalProperties": true
      },
      "default": []
    },
    "output_formats": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "custom_format": {
      "type": "string"
    },
    "quality_focus": {
      "type": "string"
    },
    "rubric_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "criteria_text": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "brian_dialog_name": {
      "type": "string"
    },
    "brian_learner_instruction": {
      "type": "string"
    },
    "brian_system_instruction": {
      "type": "string",
      "description": "Brian-Feld 3 'Interne Anweisung fuer den Chatbot' (2026-08-12): Fuer Lernende unsichtbare Anweisung, die das Bot-Verhalten steuert. Wird von generateBrianSegments aus Aufgabenstellung, Abgabeformaten, Guetekriterien/Rubriken, Projekt-Ablauf und Tutor-Persona zusammengesetzt und ist im Tab 'KI-Tutor Prompt' editierbar."
    },
    "brian_completion_rule": {
      "type": "string"
    },
    "tutor_persona": {
      "type": "string",
      "enum": [
        "standard",
        "unterstuetzend",
        "streng",
        "restriktiv"
      ],
      "default": "standard",
      "description": "Betreuungsstil des KI-Tutors - ein Baustein der internen Anweisung (brian_system_instruction)."
    },
    "tutor_persona_zusatz": {
      "type": "string",
      "description": "Optionale ergaenzende Hinweise der Lehrkraft zum Betreuungsstil (z. B. fachliche Strenge, Sprachebene, Scaffolding-Strategie)."
    },
    "brian_dialog_id": {
      "type": "string",
      "description": "ID/Kennung der Aufgabe in Brian.study (Rueckkanal des manuellen Exports)."
    },
    "brian_url": {
      "type": "string",
      "description": "Optionale direkte URL (Deep-Link) zur Aufgabe in Brian.study."
    },
    "prioritaete_lernziele": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "ki_kompetenz_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_complete": {
      "type": "boolean",
      "default": false
    },
    "content_status": {
      "type": "string",
      "enum": [
        "draft",
        "approved"
      ],
      "default": "draft"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "released_by": {
      "type": "string"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "new",
        "pending",
        "synced",
        "modified",
        "to_delete",
        "error"
      ],
      "default": "new"
    },
    "moodle_sync_status": {
      "type": "string",
      "enum": [
        "new",
        "pending",
        "synced",
        "modified",
        "error"
      ],
      "default": "new"
    },
    "brian_sync_status": {
      "type": "string",
      "enum": [
        "new",
        "pending",
        "synced",
        "modified",
        "error"
      ],
      "default": "new"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "brian_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "export_error": {
      "type": "boolean",
      "default": false
    },
    "locked_by": {
      "type": "string"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "einheit_id"
  ]
}