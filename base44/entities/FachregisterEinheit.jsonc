{
  "name": "FachregisterEinheit",
  "type": "object",
  "description": "INHALTLICHES FACHREGISTER (2026-10-07): Eine Einheit des fachlichen Wissensspeichers (schuleigener Arbeitsplan), gegliedert nach Fach und Jahrgang. 'kurse' = Kursniveaus laut Jahresarbeitsplan (Blick A = G-Kurs mit additiven E-Inhalten, Blick O = E-Kurs mit Reduktion fuer G). Sechs Abschnitte als Markdown: sachanalyse, inhalte, lernziele, kc_bezuege, fachsprache, didaktik (Ideen- und Wissensspeicher, auch fuer den Planungshelfer), material (Lehrwerksverweise). 'lehrwerk_dateien' = privat hochgeladene Lehrwerksseiten.",
  "properties": {
    "fach": {
      "type": "string"
    },
    "jahrgangsstufe": {
      "type": "string",
      "enum": [
        "5",
        "6",
        "7",
        "8",
        "9",
        "10",
        "11",
        "12",
        "13"
      ]
    },
    "titel": {
      "type": "string"
    },
    "kurse": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "beschreibung": {
      "type": "string"
    },
    "sachanalyse": {
      "type": "string"
    },
    "inhalte": {
      "type": "string"
    },
    "lernziele": {
      "type": "string"
    },
    "kc_bezuege": {
      "type": "string"
    },
    "fachsprache": {
      "type": "string"
    },
    "didaktik": {
      "type": "string"
    },
    "material": {
      "type": "string"
    },
    "lehrwerk_dateien": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "file_uri": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "reihenfolge": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "fach",
    "jahrgangsstufe",
    "titel"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}