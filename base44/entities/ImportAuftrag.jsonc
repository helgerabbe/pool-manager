{
  "name": "ImportAuftrag",
  "type": "object",
  "description": "Import-Center (2026-09-13): EIN Auftrag, der von au\u00dfen an den Pool-Manager gestellt wird. Das Freigabe-Tor: Ein Auftrag ver\u00e4ndert NIE von selbst Daten \u2014 erst wenn eine berechtigte Person (Admin, Fachschaftsleitung oder seit 2026-09-27 ein Mitarbeiter der betroffenen Einheit) 'Durchf\u00fchren' dr\u00fcckt, \u00fcbersetzt fuehreImportAuftragAus ihn in Schreibvorg\u00e4nge. Der Vertrag je auftrags_art steht in base44/shared/importAuftragSchemata.js. 'allgemeine_aufgabe_einordnen' (2026-09-27) setzt nur das Themenfeld einer allgemeinen Aufgabe und gilt f\u00fcr jeden Aufgabenmodus. 'ki_inhalt_uebernehmen' (2026-09-30) \u00fcbernimmt eine von der MBK \u00fcberarbeitete Fassung eines KI-Sch\u00fclerinhalts aus kurse/<slug>/ki-inhalte/.",
  "properties": {
    "auftrags_art": {
      "type": "string",
      "enum": [
        "einheit_anlegen",
        "themenfeld_anlegen",
        "lernpaket_anlegen",
        "aktivitaet_einfuegen",
        "aktivitaet_aendern",
        "aktivitaet_loeschen",
        "status_setzen",
        "allgemeine_aufgabe_anlegen",
        "allgemeine_aufgabe_aendern",
        "allgemeine_aufgabe_loeschen",
        "allgemeine_aufgabe_einordnen",
        "ki_inhalt_uebernehmen",
        "offene_aufgabe_anlegen",
        "offene_aufgabe_html_ersetzen",
        "schritt_einfuegen",
        "schritt_verschieben",
        "schritt_aendern",
        "schritt_entfernen"
      ],
      "description": "Was der Auftrag bewirken soll. Je Art gilt ein eigenes JSON-Schema (siehe base44/shared/importAuftragSchemata.js)."
    },
    "titel": {
      "type": "string",
      "description": "Kurze, menschenlesbare Bezeichnung des Auftrags f\u00fcr den Posteingang."
    },
    "ziel_typ": {
      "type": "string",
      "enum": [
        "keines",
        "einheit",
        "themenfeld",
        "lernpaket",
        "aktivitaet",
        "allgemeine_aufgabe"
      ],
      "default": "keines",
      "description": "Art der Stelle, auf die sich der Auftrag bezieht."
    },
    "ziel_id": {
      "type": "string",
      "description": "ID der Stelle, auf die sich der Auftrag bezieht."
    },
    "einheit_id": {
      "type": "string",
      "description": "Denormalisiert: Einheit, in der der Auftrag wirkt \u2014 Grundlage f\u00fcr Filter und f\u00fcr den Mitarbeiter-Zugang."
    },
    "position": {
      "type": "number",
      "description": "Einf\u00fcge-Position (0-basiert)."
    },
    "parameter": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "Die Nutzdaten des Auftrags \u2014 je Art unterschiedlich."
    },
    "quelle": {
      "type": "string",
      "enum": [
        "intern",
        "extern",
        "mbk"
      ],
      "default": "intern",
      "description": "Woher der Auftrag kam."
    },
    "absender": {
      "type": "string",
      "description": "E-Mail bzw. Bezeichnung des Absenders."
    },
    "pruefstatus": {
      "type": "string",
      "enum": [
        "ungeprueft",
        "geprueft",
        "ausfuehrbar"
      ],
      "default": "ungeprueft",
      "description": "Ergebnis der Pr\u00fcfung."
    },
    "pruefergebnis": {
      "type": "array",
      "default": [],
      "description": "Die L\u00fccken der letzten Pr\u00fcfung.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "fieldName": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "geprueft_am": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "eingegangen",
        "geprueft",
        "ausgefuehrt",
        "abgelehnt"
      ],
      "default": "eingegangen",
      "description": "Bearbeitungsstand im Posteingang."
    },
    "entscheid_von": {
      "type": "string",
      "description": "E-Mail der Person, die durchgef\u00fchrt oder abgelehnt hat."
    },
    "entscheid_am": {
      "type": "string",
      "format": "date-time"
    },
    "begruendung": {
      "type": "string",
      "description": "Pflichtbegr\u00fcndung bei Ablehnung; optionaler Kommentar bei Durchf\u00fchrung."
    },
    "ausfuehrung_protokoll": {
      "type": "array",
      "default": [],
      "description": "Was die Ausf\u00fchrung tats\u00e4chlich getan hat.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "schritt": {
            "type": "string"
          },
          "entity": {
            "type": "string"
          },
          "record_id": {
            "type": "string"
          },
          "hinweis": {
            "type": "string"
          }
        }
      }
    },
    "verlinkter_pruefbefund_id": {
      "type": "string",
      "description": "Optionale Br\u00fccke zum MBK-R\u00fcckmeldesystem. Bei ki_inhalt_uebernehmen wird dieser Befund beim Durchf\u00fchren auf 'behoben' gesetzt."
    }
  },
  "required": [
    "auftrags_art"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}