{
  "name": "LernpaketPhaseAktivitaet",
  "type": "object",
  "properties": {
    "lernpaket_id": {
      "type": "string",
      "description": "FK zur Lernpakete-Entity"
    },
    "phase": {
      "type": "string",
      "enum": [
        "Input",
        "\u00dcbung",
        "Abschluss"
      ],
      "description": "Lernphase"
    },
    "aktivitaet_id": {
      "type": "string",
      "description": "FK zu AktivitaetenKatalog"
    },
    "field_values": {
      "type": "object",
      "description": "Konfigurierte Feldwerte f\u00fcr diese Aktivit\u00e4t (manueller Modus). Bei erstellungs_modus='ki' typischerweise leer / null.",
      "additionalProperties": true
    },
    "material_urls": {
      "type": "array",
      "description": "Aufgabeneditor Etappe 1 (2026-07-27): An dieser Aktivit\u00e4t hinterlegte Materialien (Bilder, Texte, PDFs etc.). Werden bei der KI-Aufgabenerstellung als Kontext/Vorlage ber\u00fccksichtigt und k\u00f6nnen direkt im Aufgabeneditor hochgeladen werden.",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "is_complete": {
      "type": "boolean",
      "default": false,
      "description": "Alle Pflichtfelder ausgef\u00fcllt? Wird vom Backend ehrlich auf Basis von `lib/completenessValidation.js` berechnet. Seit der Vereinfachung des Freigabe-Workflows (2026-08-11) ist dies das ALLEIN entscheidende Kriterium einer Aktivit\u00e4t: sind alle aktiven Aktivit\u00e4ten vollst\u00e4ndig, kann das Lernpaket freigegeben werden. Eine eigene Aktivit\u00e4ts-Freigabe existiert nicht mehr."
    },
    "braucht_nacharbeit": {
      "type": "boolean",
      "default": false,
      "description": "Vereinfachter Freigabe-Workflow (2026-08-11): Selbst gesetzter Merker der Lehrkraft \u2014 'inhaltlich vollst\u00e4ndig, aber ich m\u00f6chte hier sp\u00e4ter noch einmal nachsch\u00e4rfen'. Rein informativ: blockiert WEDER die Bearbeitung NOCH die Freigabe des Lernpakets oder der Einheit. Wird in der Aktivit\u00e4ts-Ansicht, der Lernpaket-\u00dcbersicht und der Seitenleiste als Pille 'Nacharbeit' angezeigt."
    },
    "nacharbeit_notiz": {
      "type": "string",
      "description": "Optionale kurze Notiz der Lehrkraft an sich selbst, was an dieser Aktivit\u00e4t noch nachgearbeitet werden soll. Nur relevant, wenn braucht_nacharbeit=true."
    },
    "is_master": {
      "type": "boolean",
      "default": false,
      "description": "Opt-in: Diese Aktivit\u00e4t wurde zur Mastervorlage f\u00fcr KI-Klone gemacht"
    },
    "master_anzeige_modus": {
      "type": "string",
      "enum": [
        "shuffle",
        "alle"
      ],
      "default": "shuffle",
      "description": "Steuert, wie mehrere MasterAufgaben dieser (masterf\u00e4higen) Aktivit\u00e4t dem Sch\u00fcler in Moodle/Brian pr\u00e4sentiert werden. 'shuffle' (Default) = pro Versuch wird zuf\u00e4llig eine der noch nicht bearbeiteten Master-Aufgaben ausgespielt, bis alle durch sind (Wiederholungs-/Variantentraining). 'alle' = alle Master-Aufgaben sind gleichzeitig sichtbar; der Sch\u00fcler w\u00e4hlt bewusst aus bzw. bearbeitet alle. Nur relevant bei supports_master=true und \u22652 Master-Aufgaben; bei genau 1 Master spielt der Modus keine Rolle. Wird in den MBK-/Export-Payload durchgereicht \u2014 die App selbst trifft keine Laufzeit-Auswahl."
    },
    "erstellungs_modus": {
      "type": "string",
      "enum": [
        "manuell",
        "ki"
      ],
      "default": "manuell",
      "description": "AP2 / MBK-Schema v1.1.0 \u00a73: Steuert, ob diese Aktivit\u00e4t von der Lehrkraft selbst ausgearbeitet (manuell) oder von der MBK auf Basis eines strukturierten Briefings generiert (ki) werden soll."
    },
    "ki_briefing": {
      "type": "object",
      "description": "AP2 / MBK-Schema v1.1.0 \u00a74\u2013\u00a75: Strukturiertes Briefing an die MBK, wenn `erstellungs_modus='ki'`.",
      "properties": {
        "variant": {
          "type": "string",
          "enum": [
            "standard",
            "offen"
          ]
        },
        "standard": {
          "type": "object",
          "properties": {
            "schwerpunkt": {
              "type": "string"
            },
            "parameter": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "offen": {
          "type": "object",
          "properties": {
            "lernziel": {
              "type": "string"
            },
            "funktionsweise": {
              "type": "string"
            },
            "visuelle_vorlage": {
              "type": "object",
              "properties": {
                "bild_url": {
                  "type": "string"
                },
                "beschreibung": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "transkript": {
      "type": "string",
      "description": "AP2 / MBK-Integration \u00a71.4: Transkript des Medieninhalts."
    },
    "alt_text": {
      "type": "string",
      "description": "AP2 / MBK-Integration \u00a71.5: Alt-Text f\u00fcr Barrierefreiheit."
    },
    "content_status": {
      "type": "string",
      "enum": [
        "draft",
        "approved"
      ],
      "default": "draft",
      "description": "@legacy (seit 2026-08-11 ohne Wirkung): Fr\u00fcher die eigene Freigabe der Aktivit\u00e4t. Der Freigabe-Workflow wurde vereinfacht \u2014 Aktivit\u00e4ten sind nur noch 'vollst\u00e4ndig' oder 'unvollst\u00e4ndig', freigegeben wird ausschlie\u00dflich das Lernpaket. Bestandswerte bleiben erhalten, werden aber weder als Sperre noch als Freigabe-Voraussetzung gelesen."
    },
    "released_at": {
      "type": "string",
      "format": "date-time",
      "description": "@legacy: Zeitstempel der fr\u00fcheren Aktivit\u00e4ts-Freigabe. Wird nicht mehr geschrieben."
    },
    "released_by": {
      "type": "string",
      "description": "@legacy: E-Mail der Lehrkraft der fr\u00fcheren Aktivit\u00e4ts-Freigabe. Wird nicht mehr geschrieben."
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "new",
        "pending",
        "synced",
        "modified",
        "to_delete"
      ],
      "default": "new",
      "description": "Moodle-Sync-Status: new, pending, synced, modified, to_delete"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitstempel des letzten erfolgreichen Moodle-Exports"
    },
    "export_error": {
      "type": "boolean",
      "default": false,
      "description": "Phase G: Vom Export-Center auf true gesetzt, wenn der Moodle-Spezialist diese Aktivit\u00e4t im Abschluss-Dialog als 'fehlgeschlagen' markiert."
    }
  },
  "required": [
    "lernpaket_id",
    "phase",
    "aktivitaet_id"
  ]
}