{
  "name": "LookupPhasen",
  "type": "object",
  "properties": {
    "bezeichnung": {
      "type": "string",
      "description": "Bezeichnung der Phase (z.B. 'Halbjahr 1 2025/26')"
    },
    "ist_aktiv": {
      "type": "boolean",
      "default": true,
      "description": "Ob diese Phase als aktuelle Planungsphase gilt"
    }
  },
  "required": [
    "bezeichnung"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}