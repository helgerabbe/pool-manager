{
  "name": "MethodenKatalog",
  "type": "object",
  "description": "METHODENKATALOG (2026-10-04): Unterrichtsmethoden f\u00fcr die Stundenplanung (z. B. Galeriegang, Gruppenpuzzle). Enth\u00e4lt zus\u00e4tzlich die digitalen Aktivit\u00e4ten der Poolzeit (quelle='poolzeit', Verweis in poolzeit_aktivitaeten). 'modus': D = nur digital, D(A) = Standard digital, A(D) = Standard analog, A(+D) = analog mit digitaler Unterst\u00fctzung (fr\u00fcher 'F'), A = nur analog. BAUPLAN: Die Lehrkraft beschreibt die Methode frei in 'bauplan_rohtext'; die KI verteilt den Text auf die strukturierten Felder und die \u00dcbersicht.",
  "properties": {
    "name": {
      "type": "string"
    },
    "quelle": {
      "type": "string",
      "enum": [
        "methode",
        "poolzeit"
      ],
      "default": "methode",
      "description": "'poolzeit' = digitale Aktivit\u00e4t aus dem Pool-Manager-Katalog, in der Galerie farbig gekennzeichnet."
    },
    "kurzbeschreibung": {
      "type": "string",
      "description": "Ein Satz: Was ist das?"
    },
    "zweck_lernziele": {
      "type": "string",
      "description": "P\u00e4dagogischer Zweck und Lernziele."
    },
    "ablauf": {
      "type": "string"
    },
    "eignung": {
      "type": "string"
    },
    "phasen": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "einstieg",
          "erarbeitung",
          "sicherung",
          "uebung",
          "abschluss"
        ]
      }
    },
    "sozialformen": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "EA",
          "PA",
          "GA",
          "PL"
        ]
      }
    },
    "dauer_min": {
      "type": "number"
    },
    "dauer_max": {
      "type": "number"
    },
    "modus": {
      "type": "string",
      "enum": [
        "D",
        "D(A)",
        "A(D)",
        "A(+D)",
        "A"
      ]
    },
    "digital_umsetzung": {
      "type": "string"
    },
    "analog_umsetzung": {
      "type": "string"
    },
    "varianten": {
      "type": "string",
      "description": "Umsetzungsvarianten (analog / hybrid / digital) mit Vor- und Nachteilen."
    },
    "aufwand_analog": {
      "type": "string",
      "enum": [
        "keiner",
        "gering",
        "mittel",
        "hoch"
      ]
    },
    "analog_material": {
      "type": "string"
    },
    "lehreransicht": {
      "type": "string"
    },
    "schueleransicht": {
      "type": "string"
    },
    "pflicht_material": {
      "type": "string"
    },
    "optional_material": {
      "type": "string"
    },
    "beispiele": {
      "type": "string",
      "description": "Beispiele und Formulierungshilfen."
    },
    "assistent_fragen": {
      "type": "string",
      "description": "Entscheidungsbaum: je Frage die Optionen und was daraus folgt."
    },
    "pruefregeln": {
      "type": "string",
      "description": "Was der Assistent im Hintergrund pr\u00fcfen und anmahnen soll."
    },
    "bauplan_rohtext": {
      "type": "string",
      "description": "Urspr\u00fcngliche freie Beschreibung der Lehrkraft, aus der der Bauplan strukturiert wurde."
    },
    "gehoert_dazu": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "gehoert_nicht_dazu": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "bauplan_fertig": {
      "type": "boolean",
      "default": false
    },
    "poolzeit_aktivitaeten": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "ist_aktiv": {
      "type": "boolean",
      "default": true
    },
    "reihenfolge": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "name",
    "modus"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}