{
  "name": "MethodenKatalog",
  "type": "object",
  "description": "METHODENKATALOG (2026-10-04): Unterrichtsmethoden f\u00fcr die Stundenplanung (z. B. Galeriegang, Gruppenpuzzle). ADDITIV zum AktivitaetenKatalog der Poolzeit. 'modus': D = nur digital, D(A) = Standard digital, A(D) = Standard analog, F = analog mit digitaler Unterst\u00fctzung, A = nur analog. BAUPLAN: Die Lehrkraft beschreibt die Methode frei in 'bauplan_rohtext'; die KI verteilt den Text auf die strukturierten Felder (kurzbeschreibung \u2026 assistent_fragen) und die \u00dcbersicht. Gepflegt in der Aktivit\u00e4tengalerie; Grundlage f\u00fcr den Phasen-Assistenten.",
  "properties": {
    "name": {
      "type": "string"
    },
    "kurzbeschreibung": {
      "type": "string",
      "description": "Ein Satz: Was ist das?"
    },
    "ablauf": {
      "type": "string"
    },
    "eignung": {
      "type": "string"
    },
    "phasen": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "einstieg",
          "erarbeitung",
          "sicherung",
          "uebung",
          "abschluss"
        ]
      }
    },
    "sozialformen": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "EA",
          "PA",
          "GA",
          "PL"
        ]
      }
    },
    "dauer_min": {
      "type": "number"
    },
    "dauer_max": {
      "type": "number"
    },
    "modus": {
      "type": "string",
      "enum": [
        "D",
        "D(A)",
        "A(D)",
        "F",
        "A"
      ]
    },
    "digital_umsetzung": {
      "type": "string"
    },
    "analog_umsetzung": {
      "type": "string"
    },
    "aufwand_analog": {
      "type": "string",
      "enum": [
        "keiner",
        "gering",
        "mittel",
        "hoch"
      ]
    },
    "analog_material": {
      "type": "string"
    },
    "lehreransicht": {
      "type": "string"
    },
    "schueleransicht": {
      "type": "string"
    },
    "pflicht_material": {
      "type": "string"
    },
    "optional_material": {
      "type": "string"
    },
    "assistent_fragen": {
      "type": "string"
    },
    "bauplan_rohtext": {
      "type": "string",
      "description": "Urspr\u00fcngliche freie Beschreibung der Lehrkraft, aus der der Bauplan strukturiert wurde."
    },
    "gehoert_dazu": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "gehoert_nicht_dazu": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "bauplan_fertig": {
      "type": "boolean",
      "default": false
    },
    "poolzeit_aktivitaeten": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "ist_aktiv": {
      "type": "boolean",
      "default": true
    },
    "reihenfolge": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "name",
    "modus"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}