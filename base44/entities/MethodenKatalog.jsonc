{
  "name": "MethodenKatalog",
  "type": "object",
  "description": "METHODENKATALOG (2026-10-04): Unterrichtsmethoden f\u00fcr die Stundenplanung (z. B. Galeriegang, Gruppenpuzzle). ADDITIV zum AktivitaetenKatalog der Poolzeit: Dieser Katalog beschreibt die Methode im Raum, der AktivitaetenKatalog die digitalen Bausteine auf den Sch\u00fclerger\u00e4ten. 'poolzeit_aktivitaeten' verkn\u00fcpft beide. 'modus': D = nur digital, D(A) = Standard digital, A(D) = Standard analog, F = analog mit digitaler Unterst\u00fctzung, A = nur analog. BAUPLAN (2026-10-04): lehreransicht, schueleransicht, pflicht_material, optional_material und assistent_fragen beschreiben, wie die Methode im Stunden-Editor umgesetzt wird. Gepflegt in der Aktivit\u00e4tengalerie (/aktivitaetengalerie); Grundlage f\u00fcr den Phasen-Assistenten.",
  "properties": {
    "name": {
      "type": "string"
    },
    "kurzbeschreibung": {
      "type": "string",
      "description": "Ein Satz: Was ist das?"
    },
    "ablauf": {
      "type": "string",
      "description": "Wie funktioniert die Methode Schritt f\u00fcr Schritt?"
    },
    "eignung": {
      "type": "string",
      "description": "Wann passt die Methode besonders gut?"
    },
    "phasen": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "einstieg",
          "erarbeitung",
          "sicherung",
          "uebung",
          "abschluss"
        ]
      }
    },
    "sozialformen": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "EA",
          "PA",
          "GA",
          "PL"
        ]
      }
    },
    "dauer_min": {
      "type": "number"
    },
    "dauer_max": {
      "type": "number"
    },
    "modus": {
      "type": "string",
      "enum": [
        "D",
        "D(A)",
        "A(D)",
        "F",
        "A"
      ]
    },
    "digital_umsetzung": {
      "type": "string"
    },
    "analog_umsetzung": {
      "type": "string"
    },
    "aufwand_analog": {
      "type": "string",
      "enum": [
        "keiner",
        "gering",
        "mittel",
        "hoch"
      ]
    },
    "analog_material": {
      "type": "string"
    },
    "lehreransicht": {
      "type": "string",
      "description": "Bauplan: Was steht in dieser Phase an der digitalen Tafel (Lehreransicht)?"
    },
    "schueleransicht": {
      "type": "string",
      "description": "Bauplan: Was sehen und tun die Sch\u00fcler auf ihrem Ger\u00e4t?"
    },
    "pflicht_material": {
      "type": "string",
      "description": "Bauplan: Was muss zwingend vorhanden sein, damit die Methode funktioniert (z. B. Bild, Foliensatz)? Je Punkt eine Zeile."
    },
    "optional_material": {
      "type": "string",
      "description": "Bauplan: Was kann erg\u00e4nzend genutzt werden? Je Punkt eine Zeile."
    },
    "assistent_fragen": {
      "type": "string",
      "description": "Bauplan: Fragen, mit denen der Phasen-Assistent die Lehrkraft durch die Umsetzung f\u00fchrt. Je Frage eine Zeile."
    },
    "bauplan_fertig": {
      "type": "boolean",
      "default": false,
      "description": "true = Bauplan von der Lehrkraft gepr\u00fcft."
    },
    "poolzeit_aktivitaeten": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "ist_aktiv": {
      "type": "boolean",
      "default": true
    },
    "reihenfolge": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "name",
    "modus"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}