{
  "name": "MethodenKatalog",
  "type": "object",
  "description": "METHODENKATALOG (2026-10-04): Unterrichtsmethoden f\u00fcr die Stundenplanung (z. B. Galeriegang, Gruppenpuzzle). Enth\u00e4lt zus\u00e4tzlich die digitalen Aktivit\u00e4ten der Poolzeit (quelle='poolzeit', Verweis in poolzeit_aktivitaeten); diese gelten als AUFGABENFORMATE, nicht als Methoden, und erscheinen nicht in der Methodengalerie (2026-10-07). 'modus': D = nur digital, D(A) = Standard digital, A(D) = Standard analog, A(+D) = analog mit digitaler Unterst\u00fctzung, A = nur analog. BAUPLAN: Die Lehrkraft beschreibt die Methode frei in 'bauplan_rohtext'; die KI verteilt den Text auf die strukturierten Felder. ASSISTENTEN (2026-10-05): 'info_unterrichtsassistent' und 'info_grafikassistent'. GRAFISCHE VORLAGEN (2026-10-05): 'grafik_vorlagen' je Fach. METHODENRASTER (2026-10-07): 'stufe' 1-6 (siehe src/lib/methodenStufen.js), Zusatzvermerke 'auch_kurzform' und 'ausbaubar', 'stufe_pruefen' = Einordnung unsicher. FACHBEZUG (2026-10-07): 'fachbezug' + 'faecher' (siehe src/lib/methodenFachbezug.js).",
  "properties": {
    "name": {
      "type": "string"
    },
    "quelle": {
      "type": "string",
      "enum": [
        "methode",
        "poolzeit"
      ],
      "default": "methode"
    },
    "kurzbeschreibung": {
      "type": "string"
    },
    "zweck_lernziele": {
      "type": "string"
    },
    "ablauf": {
      "type": "string"
    },
    "eignung": {
      "type": "string"
    },
    "phasen": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "einstieg",
          "erarbeitung",
          "sicherung",
          "uebung",
          "abschluss"
        ]
      }
    },
    "sozialformen": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "EA",
          "PA",
          "GA",
          "PL"
        ]
      }
    },
    "dauer_min": {
      "type": "number"
    },
    "dauer_max": {
      "type": "number"
    },
    "modus": {
      "type": "string",
      "enum": [
        "D",
        "D(A)",
        "A(D)",
        "A(+D)",
        "A"
      ]
    },
    "stufe": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "description": "Komplexit\u00e4tsstufe des Methodenrasters."
    },
    "auch_kurzform": {
      "type": "boolean",
      "default": false,
      "description": "L\u00e4sst sich eine Stufe kleiner durchf\u00fchren."
    },
    "ausbaubar": {
      "type": "boolean",
      "default": false,
      "description": "L\u00e4sst sich eine Stufe gr\u00f6\u00dfer durchf\u00fchren."
    },
    "stufe_pruefen": {
      "type": "boolean",
      "default": false,
      "description": "Einordnung unsicher, bitte pr\u00fcfen."
    },
    "fachbezug": {
      "type": "string",
      "enum": [
        "fachgebunden",
        "faechergruppe",
        "uebergreifend"
      ],
      "description": "Fachgebunden = f\u00fcr ein Fach entwickelt, F\u00e4chergruppe = mehrere verwandte F\u00e4cher, \u00fcbergreifend = alle F\u00e4cher."
    },
    "faecher": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Besonders geeignete F\u00e4cher (bei fachgebunden/F\u00e4chergruppe)."
    },
    "digital_umsetzung": {
      "type": "string"
    },
    "analog_umsetzung": {
      "type": "string"
    },
    "varianten": {
      "type": "string"
    },
    "aufwand_analog": {
      "type": "string",
      "enum": [
        "keiner",
        "gering",
        "mittel",
        "hoch"
      ]
    },
    "analog_material": {
      "type": "string"
    },
    "lehreransicht": {
      "type": "string"
    },
    "schueleransicht": {
      "type": "string"
    },
    "pflicht_material": {
      "type": "string"
    },
    "optional_material": {
      "type": "string"
    },
    "beispiele": {
      "type": "string"
    },
    "assistent_fragen": {
      "type": "string"
    },
    "pruefregeln": {
      "type": "string"
    },
    "bauplan_rohtext": {
      "type": "string"
    },
    "gehoert_dazu": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "gehoert_nicht_dazu": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "info_unterrichtsassistent": {
      "type": "string"
    },
    "info_grafikassistent": {
      "type": "string"
    },
    "grafik_vorlagen": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "Je Fach: { thema, lehrer, schueler, erstellt_am }."
    },
    "bauplan_fertig": {
      "type": "boolean",
      "default": false
    },
    "poolzeit_aktivitaeten": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "ist_aktiv": {
      "type": "boolean",
      "default": true
    },
    "reihenfolge": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "name",
    "modus"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}