{
  "name": "Pruefbefund",
  "type": "object",
  "description": "Vollst\u00e4ndigkeitspr\u00fcfung (Pr\u00fcfbereich Tab 8): EIN Befund aus der Pr\u00fcfung einer gemeinschaftlichen Einheit. Kategorien 1\u20137 siehe src/lib/pruefungKategorien.js. `fingerprint` sorgt f\u00fcr Wiedererkennung. `quelle` trennt eigene Pr\u00fcfung ('regel'/'ki') von MBK-R\u00fcckmeldungen ('mbk'). R\u00dcCKWEG: Entscheidungen reisen als Antwortdatei (Format 'antwort-1') zur\u00fcck ins Repository (pushMbkAntwort). WEITERGABE (2026-10-05): 'an_mbk' = die Lehrkraft kann es nicht beheben, das Moodle-Team muss es tun (reist in der Antwortdatei als Auftrag mit); 'an_admin' = die Administration muss es tun (wird als MbkAdminTodo angelegt).",
  "properties": {
    "einheit_id": {
      "type": "string"
    },
    "prueflauf_id": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    },
    "ziel_typ": {
      "type": "string",
      "enum": [
        "aktivitaet",
        "master_aufgabe",
        "allgemeine_aufgabe",
        "systembaustein",
        "lernpaket"
      ]
    },
    "ziel_id": {
      "type": "string"
    },
    "ziel_titel": {
      "type": "string"
    },
    "fundort": {
      "type": "string"
    },
    "lernpaket_id": {
      "type": "string"
    },
    "lernpaket_titel": {
      "type": "string"
    },
    "themenfeld_id": {
      "type": "string"
    },
    "themenfeld_titel": {
      "type": "string"
    },
    "kategorie": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ]
    },
    "schwere": {
      "type": "string",
      "enum": [
        "blockiert",
        "stoert",
        "hinweis"
      ],
      "default": "hinweis"
    },
    "befund": {
      "type": "string"
    },
    "vorschlag": {
      "type": "string"
    },
    "quelle": {
      "type": "string",
      "enum": [
        "regel",
        "ki",
        "mbk"
      ],
      "default": "regel"
    },
    "mbk_quelle": {
      "type": "string",
      "enum": [
        "bau",
        "sichtung",
        "ticket"
      ]
    },
    "issue_nummer": {
      "type": "number"
    },
    "ticket_originaltext": {
      "type": "string"
    },
    "kurs_umgehung": {
      "type": "string",
      "enum": [
        "keine",
        "entfernt",
        "baustelle",
        "ausgeblendet",
        "korrektur",
        "korrektur ausgesetzt",
        "gestaltung"
      ],
      "default": "keine"
    },
    "kurs_felder": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "entscheidung": {
      "type": "string",
      "enum": [
        "offen",
        "behoben",
        "bewusst",
        "widerspruch",
        "an_mbk",
        "an_admin"
      ],
      "default": "offen",
      "description": "'an_mbk' / 'an_admin' = an das Moodle-Team bzw. die Administration weitergegeben."
    },
    "kommentar": {
      "type": "string"
    },
    "entschieden_von": {
      "type": "string"
    },
    "entschieden_am": {
      "type": "string",
      "format": "date-time"
    },
    "antwort_gesendet_am": {
      "type": "string",
      "format": "date-time"
    },
    "erneut_gefunden": {
      "type": "boolean",
      "default": false
    },
    "zuletzt_gefunden_am": {
      "type": "string",
      "format": "date-time"
    },
    "bestaetigt_behoben_am": {
      "type": "string",
      "format": "date-time"
    },
    "mbk_meldung_id": {
      "type": "string"
    },
    "mbk_quelldatei": {
      "type": "string"
    },
    "mbk_gemeldet_am": {
      "type": "string",
      "format": "date-time"
    },
    "mbk_erledigt_gemeldet_am": {
      "type": "string",
      "format": "date-time"
    },
    "dublette_status": {
      "type": "string",
      "enum": [
        "offen",
        "dublette",
        "eigenstaendig"
      ],
      "default": "offen"
    },
    "dublette_von_befund_id": {
      "type": "string"
    },
    "dublette_begruendung": {
      "type": "string"
    },
    "dublette_geprueft_am": {
      "type": "string",
      "format": "date-time"
    },
    "ki_stapel": {
      "type": "string",
      "enum": [
        "uebernehmen",
        "reparieren",
        "lehrkraft",
        "schliessen"
      ]
    },
    "ki_klartext": {
      "type": "string"
    },
    "ki_naechster_schritt": {
      "type": "string"
    },
    "ki_sortiert_am": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "einheit_id",
    "fingerprint",
    "ziel_typ",
    "ziel_id",
    "kategorie",
    "befund"
  ]
}