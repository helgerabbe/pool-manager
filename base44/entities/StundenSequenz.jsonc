{
  "name": "StundenSequenz",
  "type": "object",
  "description": "Moodle-Unterrichts-Generator (MUG, 2026-08-16): Eine Phase (Zeile des Stunden-Regieblatts) innerhalb einer Unterrichtsstunde. Streng linear ueber 'reihenfolge'. Die Phasen-Art unterscheidet analog/digital: bei digitalen Arten wird eine Aktivitaet aus dem Pool-Manager-Katalog verknuepft (aktivitaet_id + field_values), bei analogen Arten genuegen Anweisung und Material.",
  "properties": {
    "stunde_id": {
      "type": "string",
      "description": "FK zur Unterrichtsstunde."
    },
    "reihenfolge": {
      "type": "number",
      "default": 0,
      "description": "Position der Phase im Stundenablauf (0-basiert)."
    },
    "phasenname": {
      "type": "string",
      "description": "Bezeichnung der Phase (z. B. 'Einstieg', 'Arbeitsphase 1', 'Sicherung')."
    },
    "typ": {
      "type": "string",
      "enum": [
        "analog_input",
        "digital_input",
        "analog_aufgabe",
        "digital_aufgabe",
        "analog_sicherung",
        "digital_sicherung",
        "lehrer_input",
        "schueler_aktivitaet",
        "analog",
        "sicherung"
      ],
      "default": "analog_input",
      "description": "Phasen-Art (2026-08-16): 'analog_input' = Input der Lehrkraft ohne Geraet (Vortrag, Gespraech, Tafel). 'digital_input' = digital ausgespielter Input (z. B. Lehrvideo) - verknuepfte Aktivitaet. 'analog_aufgabe' = Aufgabe ohne digitale Bearbeitung (Arbeitsblatt, Gespraech). 'digital_aufgabe' = Aufgabe, die als Aktivitaet aus dem Pool-Manager verknuepft und von den Schuelern digital bearbeitet wird. 'analog_sicherung' = Sicherung/Auswertung im Plenum. 'digital_sicherung' = digitale Sicherung ueber eine verknuepfte Aktivitaet. Alle 'digital_*'-Arten ziehen eine Aktivitaet hinzu. Die Werte 'lehrer_input', 'schueler_aktivitaet', 'analog' und 'sicherung' sind @legacy-Bestandswerte und werden im Frontend auf die neuen Arten abgebildet (src/lib/stundenPhasen.js)."
    },
    "dauer_minuten": {
      "type": "number",
      "description": "Geplante Dauer der Phase in Minuten."
    },
    "lehrer_hinweis": {
      "type": "string",
      "description": "Regieanweisung fuer die Lehrkraft (erscheint auf dem gedruckten Regieblatt, NICHT fuer Schueler). Enthaelt NUR den inhaltlichen Ablauf - Methode/Sozialform und Materialhinweis liegen in eigenen Feldern (2026-08-16)."
    },
    "methode_sozialform": {
      "type": "string",
      "description": "Optionale Angabe zu Methode und Sozialform dieser Phase (z. B. 'Plenumsgespraech', 'Partnerarbeit'). Wird im Regieblatt als kleine Pille und im Phasen-Editor als eigenes Feld gepflegt."
    },
    "material_hinweis": {
      "type": "string",
      "description": "Optionaler Kurz-Hinweis auf benoetigtes Material dieser Phase als Text (z. B. 'Tafel, Impulsbild'). Ergaenzt material_urls, das hochgeladene Dateien enthaelt."
    },
    "schueler_anweisung": {
      "type": "string",
      "description": "Was die Schueler in dieser Phase auf ihrem Geraet lesen (z. B. 'Hoer zu und mach dir Notizen')."
    },
    "folien_hinweis": {
      "type": "string",
      "description": "Verweis auf Foliensatz/Praesentation (z. B. 'Folie 2-4') oder ein Link."
    },
    "material_urls": {
      "type": "array",
      "description": "Hochgeladene Materialien dieser Phase (Arbeitsblatt-Scan, PDF, Bild, Link).",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "differenzierung": {
      "type": "object",
      "description": "Differenzierungs-Hinweise der Phase: 'standard' (normale Anforderung), 'stark' (leistungsstarke Schueler), 'foerderung' (Hilfestellungen/Scaffolding).",
      "additionalProperties": true,
      "properties": {
        "standard": {
          "type": "string"
        },
        "stark": {
          "type": "string"
        },
        "foerderung": {
          "type": "string"
        }
      }
    },
    "freischalt_code": {
      "type": "string",
      "description": "Dreistelliger Zahlencode, den die Schueler eingeben, damit diese Phase im Stunden-Player freigeschaltet wird. Zufaellig vergeben, pro Stunde eindeutig, fuer die Lehrkraft jederzeit im Regieblatt sichtbar."
    },
    "aktivitaet_id": {
      "type": "string",
      "description": "Nur bei digitalen Phasen-Arten ('digital_input', 'digital_aufgabe', 'digital_sicherung'): FK zu AktivitaetenKatalog (welche digitale Aufgabenart aus dem Pool-Manager hinzugezogen wird)."
    },
    "field_values": {
      "type": "object",
      "description": "Konfigurierte Inhalte der digitalen Aktivitaet - identisches Format wie LernpaketPhaseAktivitaet.field_values, damit die bestehenden Aktivitaets-Editoren und Schueler-Renderer unveraendert genutzt werden koennen.",
      "additionalProperties": true
    },
    "is_complete": {
      "type": "boolean",
      "default": false,
      "description": "Ampel-Logik des Regieblatts: true = Phase ist vollstaendig konfiguriert (bei digitalen Arten gepruefte Verknuepfung/Vollstaendigkeit der Aktivitaet)."
    }
  },
  "required": [
    "stunde_id"
  ]
}