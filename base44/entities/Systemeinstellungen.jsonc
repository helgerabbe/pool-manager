{
  "name": "Systemeinstellungen",
  "type": "object",
  "properties": {
    "schluessel": {
      "type": "string",
      "description": "Eindeutiger Schl\u00fcssel (z.B. 'wartungsmodus')"
    },
    "wert_boolean": {
      "type": "boolean",
      "description": "Wert f\u00fcr Boolean-Einstellungen (z.B. Wartungsmodus)"
    },
    "wert_text": {
      "type": "string",
      "description": "Wert f\u00fcr Text-Einstellungen"
    }
  },
  "required": [
    "schluessel"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.schluessel": {
            "$nin": [
              "github_css_connector",
              "github_ticket_connector",
              "github_connector",
              "anthropic_connector"
            ]
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}