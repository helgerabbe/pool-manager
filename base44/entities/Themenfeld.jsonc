{
  "name": "Themenfeld",
  "type": "object",
  "properties": {
    "einheit_id": {
      "type": "string",
      "description": "Referenz zur \u00fcbergeordneten Einheit (Foreign Key)"
    },
    "titel": {
      "type": "string",
      "description": "Titel des Themenfelds (z.B. 'Grundrechenarten', 'Textanalyse')"
    },
    "art": {
      "type": "string",
      "enum": [
        "inhalt",
        "projekt"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "inhalt",
      "description": "PROJEKT-THEMENFELD (2026-11-11): 'projekt' = das feste Themenfeld 'Projektaufgaben' einer Einheit. Es gibt genau eines je Einheit (angelegt von ensureProjektThemenfeld), es steht immer an letzter Stelle und l\u00e4sst sich weder l\u00f6schen, umbenennen noch verschieben. Jedes Lernpaket darin ist ein Projekt-Lernpaket: ohne Pflicht-Kompaktwissen, ohne eigene Lernziele, ohne Einstieg/Gesamtaufgabe. Es ist kein Lernstoff und erscheint deshalb weder auf der Lernlandkarte noch als Arbeitsphase im Arbeitsplan. 'inhalt' bzw. fehlend = normales Themenfeld."
    },
    "beschreibung": {
      "type": "string",
      "description": "Kurzbeschreibung des Themenfelds (optional)"
    },
    "leitfrage": {
      "type": "string",
      "description": "Lernlandkarte (2026-09-05): Sch\u00fclergerechte Leitfrage dieses Themenfelds \u2014 die Frage, die auf dem Themenfeld-Knoten der Lernlandkarte steht (z. B. 'Was sind Quadrate und welche Eigenschaften haben sie?'). Wird von der KI aus Titel, Beschreibung und den darunterliegenden Lernzielen vorgeschlagen und kann von der Lehrkraft jederzeit \u00fcberschrieben werden. Leer = die Karte zeigt den Titel."
    },
    "reihenfolge": {
      "type": "number",
      "description": "Sortierreihenfolge innerhalb der Einheit"
    },
    "bearbeitungsmodus": {
      "type": "string",
      "enum": [
        "sequenziell",
        "offen"
      ],
      "default": "offen",
      "description": "Bearbeitungsmodus f\u00fcr dieses Themenfeld"
    },
    "content_status": {
      "type": "string",
      "enum": [
        "draft",
        "approved"
      ],
      "default": "approved",
      "description": "P\u00e4dagogischer Status: Struktur-Container sind immer 'approved' (Auto-Gr\u00fcn)"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "new",
        "pending",
        "synced",
        "modified",
        "to_delete"
      ],
      "default": "new",
      "description": "Moodle-Sync-Status: new, pending, synced, modified, to_delete"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitstempel des letzten erfolgreichen Moodle-Exports (nullable)"
    }
  },
  "required": [
    "einheit_id",
    "titel"
  ]
}