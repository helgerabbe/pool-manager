{
  "name": "Unterrichtsstunde",
  "type": "object",
  "description": "Moodle-Unterrichts-Generator (MUG, 2026-08-16): Eine einzelne, linear geplante Unterrichtsstunde ('Stunden-Regieblatt'). Sie liegt in einer UNTERRICHTSEINHEIT (unterrichtseinheit_id). Die Phasen liegen in StundenSequenz. STUNDENPLANER (2026-10-21): 'planer_stand' speichert den Zwischenstand des Stundenplaners (Schritt, Vorgaben, Entwurf), damit die Lehrkraft jederzeit weiterarbeiten kann.",
  "properties": {
    "unterrichtseinheit_id": {
      "type": "string",
      "description": "FK zur Unterrichtseinheit."
    },
    "einheit_id": {
      "type": "string",
      "description": "@legacy: ersetzt durch unterrichtseinheit_id."
    },
    "fach": {
      "type": "string"
    },
    "jahrgangsstufe": {
      "type": "string"
    },
    "arbeitstitel": {
      "type": "string"
    },
    "stundenziel": {
      "type": "string"
    },
    "teilziele": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "datum": {
      "type": "string",
      "format": "date"
    },
    "besitzer_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "entwurf",
        "bereit"
      ],
      "default": "entwurf"
    },
    "notfall_code": {
      "type": "string"
    },
    "planer_stand": {
      "type": "object",
      "additionalProperties": true,
      "description": "Zwischenstand des Stundenplaners: { phase, minuten, pause, v, punkte, entwurf, gespeichert_am }."
    },
    "coach_plan": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "steckbrief": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "zielgruppe": {
              "type": "string"
            },
            "thema": {
              "type": "string"
            },
            "dauer": {
              "type": "string"
            },
            "leitziel": {
              "type": "string"
            }
          }
        },
        "verlaufsplan": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "phasenname": {
                "type": "string"
              },
              "zeit_minuten": {
                "type": "number"
              },
              "inhalt": {
                "type": "string"
              },
              "methode_sozialform": {
                "type": "string"
              },
              "material": {
                "type": "string"
              },
              "typ": {
                "type": "string",
                "enum": [
                  "analog_input",
                  "digital_input",
                  "analog_aufgabe",
                  "digital_aufgabe",
                  "brian_aufgabe",
                  "analog_sicherung",
                  "digital_sicherung",
                  "lehrer_input",
                  "schueler_aktivitaet",
                  "analog",
                  "sicherung"
                ]
              },
              "ki_erstellen": {
                "type": "boolean",
                "default": false
              },
              "ki_aktivitaet": {
                "type": "string"
              },
              "ki_hinweis": {
                "type": "string"
              }
            }
          }
        },
        "didaktische_hinweise": {
          "type": "string"
        }
      }
    },
    "coach_verlauf": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "coach_plan_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "coach_plan_umgesetzt_am": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "arbeitstitel"
  ]
}