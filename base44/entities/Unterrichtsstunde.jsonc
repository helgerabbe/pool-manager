{
  "name": "Unterrichtsstunde",
  "type": "object",
  "description": "Moodle-Unterrichts-Generator (MUG, 2026-08-16): Eine einzelne, linear geplante Unterrichtsstunde ('Stunden-Regieblatt'). Sie liegt in einer UNTERRICHTSEINHEIT (unterrichtseinheit_id) und wird in der Privaten Bibliothek nach Fach > Unterrichtseinheit gruppiert angezeigt. Die eigentlichen Phasen liegen in der StundenSequenz-Entity.\n\nBEGRIFFSTRENNUNG (2026-09-14): Eine UNTERRICHTSEINHEIT ist die thematische Mappe im Bereich 'Mein Unterricht'. Sie ist etwas anderes als eine EINHEIT (Entity 'Einheiten') - das vollstaendige Lernszenario mit Lernpfaden, Dashboards und Moodle-Kurs. Beide Begriffe existieren nebeneinander und sind bewusst getrennte Datensaetze.",
  "properties": {
    "unterrichtseinheit_id": {
      "type": "string",
      "description": "FK zur UNTERRICHTSEINHEIT (Entity 'Unterrichtseinheit'), in der diese Stunde liegt."
    },
    "einheit_id": {
      "type": "string",
      "description": "@legacy: Frueher die Gruppierung ueber eine 'Einheit' (Entity 'Einheiten'). Ersetzt durch unterrichtseinheit_id; wird nicht mehr geschrieben."
    },
    "fach": {
      "type": "string",
      "description": "Denormalisiert aus der Unterrichtseinheit - fuer die Gruppierung nach Fach."
    },
    "jahrgangsstufe": {
      "type": "string",
      "description": "Denormalisiert aus der Unterrichtseinheit."
    },
    "arbeitstitel": {
      "type": "string",
      "description": "Arbeitstitel der Stunde zur Wiedererkennung in der Bibliothek."
    },
    "stundenziel": {
      "type": "string",
      "description": "Das Stundenziel (eine Formulierung)."
    },
    "teilziele": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Optionale Teilziele der Stunde."
    },
    "datum": {
      "type": "string",
      "format": "date",
      "description": "Optionales geplantes Datum der Stunde."
    },
    "besitzer_email": {
      "type": "string",
      "description": "E-Mail der planenden Lehrkraft."
    },
    "status": {
      "type": "string",
      "enum": [
        "entwurf",
        "bereit"
      ],
      "default": "entwurf",
      "description": "'entwurf' = in Planung. 'bereit' = alle Phasen vollstaendig, Stunde ist fuer den Unterricht/Moodle einsetzbar."
    },
    "notfall_code": {
      "type": "string",
      "description": "Notfall-Schluessel der Stunde: schaltet im Stunden-Player JEDE Phase frei, falls der Lehrkraft die Phasen-Codes im Unterricht nicht vorliegen."
    },
    "coach_plan": {
      "type": "object",
      "description": "KI-Generator fuer das Stundenregieblatt (MUG Paket 2, 2026-08-16): Die im Dialog entstandene 'Bauanleitung' der Stunde. Sie bleibt dauerhaft erhalten - auch nachdem daraus Phasen (StundenSequenz) generiert wurden - und kann jederzeit weiterentwickelt und erneut umgesetzt werden. Struktur: steckbrief, verlaufsplan und didaktische_hinweise.",
      "additionalProperties": true,
      "properties": {
        "steckbrief": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "zielgruppe": {
              "type": "string"
            },
            "thema": {
              "type": "string"
            },
            "dauer": {
              "type": "string"
            },
            "leitziel": {
              "type": "string"
            }
          }
        },
        "verlaufsplan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "phasenname": {
                "type": "string"
              },
              "zeit_minuten": {
                "type": "number"
              },
              "inhalt": {
                "type": "string"
              },
              "methode_sozialform": {
                "type": "string"
              },
              "material": {
                "type": "string"
              },
              "typ": {
                "type": "string",
                "enum": [
                  "analog_input",
                  "digital_input",
                  "analog_aufgabe",
                  "digital_aufgabe",
                  "brian_aufgabe",
                  "analog_sicherung",
                  "digital_sicherung",
                  "lehrer_input",
                  "schueler_aktivitaet",
                  "analog",
                  "sicherung"
                ]
              },
              "ki_erstellen": {
                "type": "boolean",
                "default": false,
                "description": "KI-Mit-Erstellung (2026-08-16): true = beim Umsetzen der Bauanleitung soll die digitale Aufgabe dieser Phase gleich von der KI erzeugt werden."
              },
              "ki_aktivitaet": {
                "type": "string",
                "description": "Name der Aufgabenart aus dem AktivitaetenKatalog, die fuer diese Phase erzeugt werden soll."
              },
              "ki_hinweis": {
                "type": "string",
                "description": "Zusaetzliche inhaltliche Hinweise der Lehrkraft fuer die KI-Aufgabengenerierung dieser Phase."
              }
            }
          },
          "default": []
        },
        "didaktische_hinweise": {
          "type": "string"
        }
      }
    },
    "coach_verlauf": {
      "type": "array",
      "description": "Chat-Verlauf mit dem KI-Generator (Rollen 'user' und 'assistant'). Wird gespeichert, damit die Lehrkraft das Gespraech spaeter fortsetzen kann.",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "coach_plan_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitstempel der letzten Aenderung der Bauanleitung."
    },
    "coach_plan_umgesetzt_am": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitstempel, zu dem aus der Bauanleitung zuletzt Phasen (StundenSequenz) generiert wurden."
    }
  },
  "required": [
    "arbeitstitel"
  ]
}