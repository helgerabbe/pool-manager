{
  "name": "Unterrichtsstunde",
  "type": "object",
  "description": "Moodle-Unterrichts-Generator (MUG, 2026-08-16): Eine einzelne, linear geplante Unterrichtsstunde ('Stunden-Regieblatt'). Sie liegt in einer UNTERRICHTSEINHEIT (unterrichtseinheit_id). Die Phasen liegen in StundenSequenz. STUNDENPLANER (2026-10-21): 'planer_stand' speichert den Zwischenstand des Stundenplaners (Schritt, Vorgaben, Entwurf), damit die Lehrkraft jederzeit weiterarbeiten kann. STUNDENBAU (2026-10-25): 'stundenbau' h\u00e4lt den Foliensatz, den der Stundenbau-Assistent Phase f\u00fcr Phase baut: { phasen: { <Index der Planer-Phase>: { einleitung, fragen[], antworten, annahmen[], folien[], fertig } } }. STUNDENFORM (2026-11-04): 'stundenform' h\u00e4lt fest, welche Art von Stunde gemacht wird (Stundenform + Variante der didaktischen Konzeption, Schl\u00fcssel aus src/lib/stundenModelle.js und den Varianten-Dateien). Status: herausgehoert -> empfohlen -> vorlaeufig / festgelegt. Erst mit Variante kennt der Methodenassistent die Phasenfolge.",
  "properties": {
    "unterrichtseinheit_id": {
      "type": "string",
      "description": "FK zur Unterrichtseinheit."
    },
    "einheit_id": {
      "type": "string",
      "description": "@legacy: ersetzt durch unterrichtseinheit_id."
    },
    "fach": {
      "type": "string"
    },
    "jahrgangsstufe": {
      "type": "string"
    },
    "arbeitstitel": {
      "type": "string"
    },
    "stundenziel": {
      "type": "string"
    },
    "teilziele": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "datum": {
      "type": "string",
      "format": "date"
    },
    "besitzer_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "entwurf",
        "bereit"
      ],
      "default": "entwurf"
    },
    "notfall_code": {
      "type": "string"
    },
    "stundenform": {
      "type": "object",
      "description": "Art der Stunde nach der didaktischen Konzeption.",
      "properties": {
        "form": {
          "type": "string",
          "description": "Schl\u00fcssel der Stundenform, z. B. 'einstieg', 'erarbeitung', 'uebung', 'diagnose'."
        },
        "variante": {
          "type": "string",
          "description": "Schl\u00fcssel der Variante, z. B. 'gelenkt_entdeckend' oder bei \u00dcbung/Diagnose 'kurz', 'mittel', 'lang'."
        },
        "status": {
          "type": "string",
          "enum": [
            "herausgehoert",
            "empfohlen",
            "vorlaeufig",
            "festgelegt"
          ],
          "enumColors": [
            "gray",
            "blue",
            "yellow",
            "green"
          ],
          "description": "herausgehoert = Arbeitsannahme des Assistenten; empfohlen = Assistent empfiehlt mit Begr\u00fcndung; vorlaeufig = Lehrkraft plant ohne Festlegung weiter; festgelegt = Lehrkraft hat best\u00e4tigt."
        },
        "alternativen": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Weitere in Frage kommende Varianten."
        },
        "begruendung": {
          "type": "string",
          "description": "Kurze Begr\u00fcndung der Empfehlung bzw. Wahl."
        },
        "absicht": {
          "type": "string",
          "description": "Was die Lehrkraft mit der Stunde vor allem will, in ihren Worten."
        },
        "geaendert_am": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "planer_stand": {
      "type": "object",
      "additionalProperties": true,
      "description": "Zwischenstand des Stundenplaners: { phase, minuten, pause, v, punkte, entwurf, gespeichert_am }."
    },
    "stundenbau": {
      "type": "object",
      "additionalProperties": true,
      "description": "Foliensatz aus dem Stundenbau-Assistenten, je Phase: { phasen: { '0': { einleitung, fragen, antworten, annahmen, folien, fertig } } }."
    },
    "coach_plan": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "steckbrief": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "zielgruppe": {
              "type": "string"
            },
            "thema": {
              "type": "string"
            },
            "dauer": {
              "type": "string"
            },
            "leitziel": {
              "type": "string"
            }
          }
        },
        "verlaufsplan": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "phasenname": {
                "type": "string"
              },
              "zeit_minuten": {
                "type": "number"
              },
              "inhalt": {
                "type": "string"
              },
              "methode_sozialform": {
                "type": "string"
              },
              "material": {
                "type": "string"
              },
              "typ": {
                "type": "string",
                "enum": [
                  "analog_input",
                  "digital_input",
                  "analog_aufgabe",
                  "digital_aufgabe",
                  "brian_aufgabe",
                  "analog_sicherung",
                  "digital_sicherung",
                  "lehrer_input",
                  "schueler_aktivitaet",
                  "analog",
                  "sicherung"
                ]
              },
              "ki_erstellen": {
                "type": "boolean",
                "default": false
              },
              "ki_aktivitaet": {
                "type": "string"
              },
              "ki_hinweis": {
                "type": "string"
              }
            }
          }
        },
        "didaktische_hinweise": {
          "type": "string"
        }
      }
    },
    "coach_verlauf": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "coach_plan_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "coach_plan_umgesetzt_am": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "arbeitstitel"
  ]
}