{
  "name": "Lernziel Ebene 1 \u2013 Baustein-Templates generieren",
  "description": "Generiert automatisch Aufgabenbaustein-Platzhalter, wenn ein Lernziel der Ebene 1 mit Kategorie angelegt wird.",
  "trigger": {
    "condition": "${ (.trigger.data.anforderungsebene == \"Ebene 1 - Basis\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Lernziele"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "lernziel_ebene_1_baustein_templates_generieren",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onLernzielCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onLernzielCreated"
  }
}