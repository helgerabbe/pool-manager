{
  "name": "Projekt-Themenfeld bei neuer Einheit anlegen",
  "description": "Legt beim Erstellen einer Einheit automatisch das feste Themenfeld \"Projektaufgaben\" an (einmal je Einheit; nicht bei \u00dcbungsbl\u00f6cken und Basismodulen).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Einheiten"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "projekt_themenfeld_bei_neuer_einheit_anlegen",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "projekt_themenfeld_anlegen": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ensureProjektThemenfeld",
            "args": {
              "einheit_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Themenfeld \u201eProjektaufgaben\" anlegen"
          }
        }
      }
    ]
  }
}